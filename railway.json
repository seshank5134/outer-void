{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "services": {
    "backend": {
      "source": "backend",
      "start": {
        "command": "gunicorn -w 2 -k uvicorn.workers.UvicornWorker main:app --bind 0.0.0.0:$PORT"
      }
    },
    "frontend": {
      "source": "frontend",
      "build": {
        "command": "if [ ! -d 'flutter' ]; then git clone https://github.com/flutter/flutter.git -b stable; fi && ./flutter/bin/flutter build web --release"
      },
      "start": {
        "command": "npx serve -s build/web -p $PORT"
      }
    }
  }
}
